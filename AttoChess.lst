    29                                  ;
    30                                  ; AttoChess 272-byte release, NASM syntax.
    31                                  ;
    32                                  ; Derived from the fingerprinted 276-byte AttoChess distribution artifact.
    33                                  ; The original four reductions are documented below. Search now starts at
    34                                  ; -128 rather than zero, accepting losing replies. Removing the redundant
    35                                  ; AND AH,DL after the destination guard pays for the two-byte initializer.
    36                                  ;
    37                                  ; (1) The move prologue exchanges zero into the source before testing the
    38                                  ;     resulting AL. On the nonempty path this is identical to the source;
    39                                  ;     on the empty path it changes no memory and enters the same deliberate
    40                                  ;     infinite loop. Reusing AL makes the three-byte memory CMP unnecessary.
    41                                  ;
    42                                  ; (2) The pawn predicate is occupancy == vector-parity. AND/NEG obtains the
    43                                  ;     occupancy bit in CF (the guarded NEG alone now suffices); RCL maps
    44                                  ;     occupancy and vector parity into AL bits
    45                                  ;     0 and 1; TEST makes PF true iff those bits agree. PUSH/POP restores the
    46                                  ;     original AX while preserving PF. AH therefore remains available for
    47                                  ;     undo, eliminating the old destination clone in BH.
    48                                  ;
    49                                  ; (3) eval_db's final king value, 2Eh, is also init_db's first top-border fill
    50                                  ;     byte. It has the border bit for both 18h and 28h masks, is outside the
    51                                  ;     displayed/scanned board rows, and remains the exact XLAT value at index 7.
    52                                  ;     Overlapping the two tables removes one data byte.
    53                                  ;
    54                                  ; (4) AH-based undo leaves BH free. eval_db, moves_db, and all vectors reside
    55                                  ;     in runtime page 01xx, so BH=01h from MOV BX,eval_db can remain invariant.
    56                                  ;     MOVES_DB lives in the dead island after SUB_RET. Its absolute low-byte
    57                                  ;     vector pointers plus the preserved BH allow a disp8 LEA, saving one byte.
    58                                  
    59                                  bits 16
    60                                  cpu 186
    61                                  org 100h
    62                                  
    63                                  start:
    64 00000000 FC                          cld
    65 00000001 B90D00                      mov cx, 13
    66 00000004 BE[F800]                    mov si, init_db
    67 00000007 BF[1001]                    mov di, board_db
    68                                  
    69                                  init_loop:
    70 0000000A 51                          push cx
    71 0000000B B80D0A                      mov ax, 0A0Dh
    72 0000000E AB                          stosw
    73 0000000F AB                          stosw
    74 00000010 B108                        mov cl, 8
    75 00000012 AC                          lodsb
    76 00000013 A880                        test al, 80h
    77 00000015 7403                        jz init_cont
    78 00000017 4E                          dec si
    79 00000018 F3A4                        rep movsb
    80                                  
    81                                  init_cont:
    82 0000001A F3AA                        rep stosb
    83 0000001C 59                          pop cx
    84 0000001D E2EB                        loop init_loop
    85                                  
    86                                  main_loop:
    87 0000001F BE[2801]                    mov si, board_db + 24
    88 00000022 B162                        mov cl, 98
    89                                  
    90                                  disp_loop:
    91 00000024 AC                          lodsb
    92 00000025 A830                        test al, 30h
    93 00000027 7405                        jz disp_cont
    94                                  
    95                                  disp_piece:
    96 00000029 40                          inc ax
    97 0000002A 2427                        and al, 27h
    98 0000002C 044B                        add al, 4Bh
    99                                  
   100                                  disp_cont:
   101 0000002E CD29                        int 29h
   102 00000030 E2F2                        loop disp_loop
   103                                  
   104                                  play:
   105 00000032 BA2818                      mov dx, 1828h
   106 00000035 B104                        mov cl, 4
   107 00000037 68[1F00]                    push word main_loop
   108 0000003A B8[5B00]                    mov ax, move_sub
   109 0000003D 50                          push ax
   110 0000003E 50                          push ax
   111 0000003F 68[4200]                    push word read_sub
   112                                  
   113                                  read_sub:
   114 00000042 89FD                        mov bp, di
   115 00000044 BF[6B0E]                    mov di, board_db + 123 + 0CE0h
   116 00000047 B401                        mov ah, 01h
   117 00000049 CD21                        int 21h
   118 0000004B 01C7                        add di, ax
   119 0000004D CD21                        int 21h
   120 0000004F 6BC00C                      imul ax, 12
   121 00000052 29C7                        sub di, ax
   122                                  
   123                                  sub_ret:
   124 00000054 C3                          ret
   125                                  
   126                                  ; Absolute low-byte vector pointers. SUB_RET prevents fallthrough, while all
   127                                  ; direct move calls enter MOVE_SUB below this table.
   128                                  moves_db:
   129 00000055 E4                          moves_knight db vec_knight - $$
   130 00000056 EA                          moves_bishop db vec_bishop - $$
   131 00000057 E9                          moves_pawn   db vec_pawn   - $$
   132 00000058 ED                          moves_queen  db vec_king   - $$
   133 00000059 EF                          moves_rook   db vec_rook   - $$
   134 0000005A ED                          moves_king   db vec_king   - $$
   135                                  
   136                                  ; BX is 0100h+type, while MOVES_DB[type-2] is at
   137                                  ; 0100h+(MOVES_DB-$$)+(type-2).  Subtracting $$ makes this an absolute
   138                                  ; assembly-time scalar, so NASM can prove the displacement fits in int8.
   139                                  moves_disp equ moves_db - $$ - 2
   140                                  
   141                                  move_sub:
   142 0000005B 31C0                        xor ax, ax
   143 0000005D 864600                      xchg al, [bp]
   144 00000060 84C0                        test al, al
   145 00000062 74FE                        jz $
   146 00000064 8605                        xchg al, [di]
   147 00000066 86D6                        xchg dl, dh
   148                                  
   149 00000068 2407                        and al, 07h
   150 0000006A BB[F100]                    mov bx, eval_db
   151 0000006D D7                          xlatb
   152 0000006E E3E4                        jcxz sub_ret
   153                                  
   154                                  next:
   155 00000070 B480                        mov ah, 80h                    ; Accept the best reply even when losing.
   156 00000072 60                          pusha
   157 00000073 BD[2C01]                    mov bp, board_db + 28
   158                                  
   159                                  src_loop:
   160 00000076 8A5E00                      mov bl, [bp]
   161 00000079 84D3                        test bl, dl
   162 0000007B 755C                        jnz src_cont
   163                                  
   164                                      ; Preserve BH=01h while isolating the type. MOVES_DISP=53h is the signed
   165                                      ; disp8 from BX=0100h+type to MOVES_DB[type-2].
   166 0000007D 80E307                      and bl, 07h
   167 00000080 7457                        jz src_cont
   168                                  
   169                                      ; The BYTE qualifier is an encoding proof obligation: NASM otherwise
   170                                      ; conservatively selects disp16 for a relocatable label expression.
   171 00000082 8D7753                      lea si, [byte bx + moves_disp]
   172 00000085 AC                          lodsb
   173 00000086 88FC                        mov ah, bh
   174 00000088 96                          xchg ax, si
   175                                  
   176                                  vec_loop:
   177 00000089 AC                          lodsb
   178                                  
   179                                  sign_loop:
   180 0000008A 89EF                        mov di, bp
   181                                  
   182                                  dest_loop:
   183 0000008C 98                          cbw
   184 0000008D 01C7                        add di, ax
   185 0000008F 8A25                        mov ah, [di]
   186 00000091 84F4                        test ah, dh
   187 00000093 753E                        jnz vec_cont
   188                                  
   189 00000095 80FB04                      cmp bl, 04h
   190 00000098 7512                        jne eval
   191                                  
   192                                  pawn:
   193 0000009A 50                          push ax
   194 0000009B 30F0                        xor al, dh
   195 0000009D A820                        test al, 20h
   196 0000009F 58                          pop ax
   197 000000A0 7431                        jz vec_cont
   198                                  
   199                                      ; Preserve AX while mapping occupancy and vector parity to two low bits.
   200 000000A2 50                          push ax
   201                                      ; The destination guard rejected friendly pieces and borders.
   202                                      ; Among remaining board cells, nonzero means an enemy piece.
   203 000000A3 F6DC                        neg ah
   204 000000A5 D0D0                        rcl al, 1
   205 000000A7 A803                        test al, 3
   206 000000A9 58                          pop ax
   207 000000AA 7B27                        jpo vec_cont
   208                                  
   209                                  eval:
   210 000000AC 60                          pusha
   211 000000AD 55                          push bp
   212 000000AE 57                          push di
   213                                  
   214 000000AF 89E6                        mov si, sp
   215 000000B1 49                          dec cx
   216 000000B2 E8A6FF                      call move_sub
   217 000000B5 3A4423                      cmp al, [si + 35]
   218 000000B8 5F                          pop di
   219 000000B9 5D                          pop bp
   220 000000BA 7C09                        jl undo
   221                                  
   222                                  best:
   223 000000BC 884423                      mov [si + 35], al
   224 000000BF 897C14                      mov [si + 20], di
   225 000000C2 896C18                      mov [si + 24], bp
   226                                  
   227                                  undo:
   228 000000C5 61                          popa
   229                                      ; The predicate restored AX, so AH still holds the original destination.
   230 000000C6 8625                        xchg ah, [di]
   231 000000C8 886600                      mov [bp], ah
   232 000000CB 8415                        test [di], dl
   233 000000CD 7504                        jnz vec_cont
   234                                  
   235 000000CF 84DB                        test bl, bl
   236 000000D1 7AB9                        jpe dest_loop
   237                                  
   238                                  vec_cont:
   239 000000D3 F6D8                        neg al
   240 000000D5 78B3                        js sign_loop
   241 000000D7 75B0                        jnz vec_loop
   242                                  
   243                                  src_cont:
   244 000000D9 45                          inc bp
   245 000000DA 81FD[8801]                  cmp bp, board_db + 120
   246 000000DE 7596                        jnz src_loop
   247                                  
   248                                  move_done:
   249 000000E0 61                          popa
   250 000000E1 28E0                        sub al, ah
   251 000000E3 C3                          ret
   252                                  
   253 000000E4 0A0E171900                  vec_knight db 10, 14, 23, 25, 0
   254 000000E9 0C                          vec_pawn   db 12
   255 000000EA 0B0D00                      vec_bishop db 11, 13, 0
   256 000000ED 0B0D                        vec_king   db 11, 13
   257 000000EF 0C01                        vec_rook   db 12, 1
   258                                  
   259                                  eval_db:
   260 000000F1 00000303010905              db 0, 0, 3, 3, 1, 9, 5
   261                                  
   262                                  init_db:
   263 000000F8 2E09                        db 2Eh, 09h
   264 000000FA A6A2A3A5A7A3A2A6            db 0A6h, 0A2h, 0A3h, 0A5h, 0A7h, 0A3h, 0A2h, 0A6h
   265 00000102 24                          db 24h
   266 00000103 00000000                    db 00h, 00h, 00h, 00h
   267 00000107 14                          db 14h
   268 00000108 9692939597939296            db 96h, 92h, 93h, 95h, 97h, 93h, 92h, 96h
   269                                  
   270                                  board_db:
